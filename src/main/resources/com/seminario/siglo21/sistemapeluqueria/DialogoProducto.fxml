<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-pane" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seminario.siglo21.sistemapeluqueria.controlador.DialogoProductoController">
    <top>
        <HBox spacing="10.0" styleClass="top-bar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="titulo-app" text="Gestión de Productos - Agregar o Editar Producto" />
            </children>
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <children>
                <Label styleClass="subtitulo-login" text="Datos del Producto" />
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtSku" prefHeight="39.0" prefWidth="72.0" promptText="SKU" styleClass="md-textfield" />
                        <TextField fx:id="txtNombreProducto" promptText="Nombre del producto" styleClass="md-textfield" />
                        <TextField fx:id="txtDescripcionProducto" prefHeight="39.0" prefWidth="212.0" promptText="Descripción del producto" styleClass="md-textfield" />
                    </children>
                </HBox>
            <HBox layoutX="26.0" layoutY="188.0" prefHeight="18.0" prefWidth="472.0">
               <children>
                  <VBox prefHeight="61.0" prefWidth="229.0">
                     <children>
                        <Label prefHeight="38.0" prefWidth="225.0" styleClass="subtitulo-login" text="Marca">
                           <padding>
                              <Insets bottom="10.0" right="10.0" top="10.0" />
                           </padding>
                        </Label>
                        <ComboBox fx:id="cmbMarca" prefHeight="23.0" prefWidth="207.0" />
                     </children>
                     <padding>
                        <Insets right="20.0" />
                     </padding>
                  </VBox>
                  <VBox prefHeight="61.0" prefWidth="217.0">
                     <children>
                        <Label prefHeight="38.0" prefWidth="183.0" styleClass="subtitulo-login" text="Proveedor">
                           <padding>
                              <Insets bottom="10.0" right="10.0" top="10.0" />
                           </padding>
                        </Label>
                        <ComboBox fx:id="cmbProveedor" prefHeight="23.0" prefWidth="186.0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox prefHeight="18.0" prefWidth="472.0">
               <children>
                  <VBox prefHeight="77.0" prefWidth="139.0">
                     <children>
                            <Label prefHeight="38.0" prefWidth="141.0" styleClass="subtitulo-login" text="Precio de Costo">
                           <padding>
                              <Insets bottom="10.0" right="10.0" top="10.0" />
                           </padding>
                        </Label>
                              <TextField fx:id="txtPrecioCosto" prefHeight="39.0" prefWidth="118.0" promptText="Precio de costo" styleClass="md-textfield">
                           <padding>
                              <Insets bottom="10.0" left="10.0" />
                           </padding>
                        </TextField>
                     </children>
                     <padding>
                        <Insets right="20.0" />
                     </padding>
                  </VBox>
                  <VBox prefHeight="77.0" prefWidth="120.0">
                     <children>
                        <Label prefHeight="38.0" prefWidth="118.0" styleClass="subtitulo-login" text="Precio de Venta">
                           <padding>
                              <Insets bottom="10.0" right="10.0" top="10.0" />
                           </padding>
                        </Label>
                              <TextField fx:id="txtPrecioVenta" prefHeight="39.0" prefWidth="128.0" promptText="Precio de venta" styleClass="md-textfield" />
                     </children>
                  </VBox>
               </children>
            </HBox>
                <HBox alignment="CENTER" layoutX="26.0" layoutY="269.0" spacing="10.0">
                    <children>
                        <Label fx:id="lblMensaje" styleClass="mensaje" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" layoutX="26.0" layoutY="56.0" spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#Guardar" styleClass="btn-primary" text="Guardar" />
                        <Button fx:id="Cancelar" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#Cancelar" styleClass="btn-secondary" text="Cancelar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
    <bottom>
        <Label styleClass="pie" text="© 2025 Seminario de Práctica Informática - Siglo 21" BorderPane.alignment="TOP_LEFT" />
    </bottom>
</BorderPane>
