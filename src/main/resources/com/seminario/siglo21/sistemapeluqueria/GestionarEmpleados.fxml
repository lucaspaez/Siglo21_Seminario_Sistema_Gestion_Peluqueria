<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" styleClass="root-pane" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seminario.siglo21.sistemapeluqueria.controlador.GestionarEmpleadosController">
    <top>
        <VBox styleClass="top-bar">
            <Label styleClass="titulo-app" text="Gestión de Empleados" />
        </VBox>
    </top>

    <center>
        <TableView fx:id="tvEmpleados" styleClass="md-table">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                <TableColumn fx:id="colApellido" prefWidth="200.0" text="Apellido" />
                <TableColumn fx:id="colDNI" prefWidth="150.0" text="DNI" />
                <TableColumn fx:id="colActivo" prefWidth="100.0" text="Activo" />
            </columns>
        </TableView>
        <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </BorderPane.margin>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" minWidth="200" spacing="15" styleClass="sidebar">
         <Separator />
            <Button fx:id="btnNuevo" maxWidth="Infinity" onAction="#handleNuevo" styleClass="btn-primary" text="➕ Nuevo Empleado" textAlignment="CENTER">
            <opaqueInsets>
               <Insets />
            </opaqueInsets></Button>
            <Button fx:id="btnEditar" maxWidth="Infinity" onAction="#handleEditar" styleClass="btn-secondary" text="✏️ Editar Seleccionado" />
            <Button fx:id="btnEliminar" maxWidth="Infinity" onAction="#handleEliminar" styleClass="btn-secondary" text="❌ Inactivar" />
            <Separator />
            <Button fx:id="btnVolver" maxWidth="Infinity" onAction="#handleVolver" styleClass="btn-secondary" text="Volver al Menú" />
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
        </VBox>
    </right>
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
</BorderPane>
