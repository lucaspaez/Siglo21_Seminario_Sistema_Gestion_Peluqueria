<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="900" styleClass="root-pane" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seminario.siglo21.sistemapeluqueria.controlador.GestionarProveedoresController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
            <Label styleClass="titulo-app" text="Gestión de Proveedores" />
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">

            <HBox spacing="10">
                <TextField fx:id="txtFiltroRazonSocial" prefWidth="300" promptText="Filtrar por Razón Social" styleClass="md-textfield" />
            </HBox>
            <TableView fx:id="tablaProveedores" prefHeight="380" styleClass="md-table">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="42.0" text="ID" />
                    <TableColumn fx:id="colRazonSocial" prefWidth="165.0" text="Razón Social" />
                    <TableColumn fx:id="colCuit" prefWidth="126.0" text="Cuit" />
                    <TableColumn fx:id="colTelefono" prefWidth="96.0" text="Telefono" />
                    <TableColumn fx:id="colEmail" prefWidth="176.0" text="Email" />
                    <TableColumn fx:id="colDireccion" maxWidth="270.0" prefWidth="256.0" text="Dirección" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="btnAgregar" onAction="#agregarProveedor" styleClass="btn-primary" text="Agregar" />
                <Button fx:id="btnEditar" onAction="#editarProveedor" styleClass="btn-secondary" text="Editar" />
                <Button fx:id="btnEliminar" onAction="#eliminarProveedor" styleClass="btn-secondary" text="Eliminar" />
                <Button fx:id="btnRefrescar" onAction="#refrescarTabla" styleClass="btn-secondary" text="Refrescar" />
                <Button fx:id="btnVolver" layoutX="252.0" layoutY="11.0" onAction="#volverAtras" styleClass="btn-secondary" text="&lt;&lt;" />
            </HBox>
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
        </VBox>
    </center>

    <bottom>
        <Label styleClass="pie" text="© 2025 Seminario de Práctica Informática - Siglo 21" />
    </bottom>
</BorderPane>
