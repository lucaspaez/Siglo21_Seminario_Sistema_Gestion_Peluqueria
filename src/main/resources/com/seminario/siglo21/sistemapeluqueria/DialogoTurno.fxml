<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="400.0" spacing="15.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seminario.siglo21.sistemapeluqueria.controlador.DialogoTurnoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="lblTitulo" text="Programar Nuevo Turno" />
        <GridPane hgap="10.0" vgap="10.0">
            <children>

                <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbCliente" prefWidth="250.0" promptText="Seleccionar cliente..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Estilista (Empleado):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbEmpleado" prefWidth="250.0" promptText="Seleccionar estilista..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <DatePicker fx:id="dpFecha" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Hora de Inicio:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbHora" prefWidth="250.0" promptText="Seleccionar hora..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <ComboBox fx:id="cmbEstado" prefWidth="250.0" promptText="Seleccionar estado..." GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label text="Servicios a Realizar:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <ListView fx:id="lvServicios" prefHeight="100.0" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Observaciones:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                <TextArea fx:id="txtObservaciones" prefHeight="100.0" prefWidth="250.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="7" />

            </children>

            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="100.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="120.0" vgrow="SOMETIMES" />
            </rowConstraints>

        </GridPane>
      <Label fx:id="lblMensaje" styleClass="mensaje" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleCancel" styleClass="btn-secondary" text="Cancelar" />
                <Button fx:id="btnGuardar" onAction="#handleSave" styleClass="btn-primary" text="Guardar Turno" />
            </children>
        </HBox>
    </children>
</VBox>
