<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="900" styleClass="root-pane" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seminario.siglo21.sistemapeluqueria.controlador.GestionarClientesController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
            <Label styleClass="titulo-app" text="Gestión de Clientes" />
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <TableView fx:id="tablaClientes" prefHeight="380" styleClass="md-table">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="300" text="Nombre" />
                    <TableColumn fx:id="colDni" prefWidth="160" text="DNI" />
                    <TableColumn fx:id="colDireccion" prefWidth="120" text="ID Dirección" />
                </columns>
            </TableView>

            <HBox spacing="10">
                <TextField fx:id="txtNombre" prefWidth="300" promptText="Nombre" styleClass="md-textfield" />
                <TextField fx:id="txtDni" prefWidth="180" promptText="DNI" styleClass="md-textfield" />
                <TextField fx:id="txtDireccion" prefWidth="160" promptText="ID Dirección (opcional)" styleClass="md-textfield" />
            </HBox>

            <HBox spacing="10">
                <Button fx:id="btnAgregar" styleClass="btn-primary" text="Agregar" />
                <Button fx:id="btnEditar" styleClass="btn-secondary" text="Editar" />
                <Button fx:id="btnEliminar" styleClass="btn-secondary" text="Eliminar" />
                <Button fx:id="btnRefrescar" styleClass="btn-ghost" text="Refrescar" />
            </HBox>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
        </VBox>
    </center>

    <bottom>
        <Label styleClass="pie" text="© 2025 Seminario de Práctica Informática - Siglo 21" />
    </bottom>
</BorderPane>
