<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-pane" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seminario.siglo21.sistemapeluqueria.controlador.DialogoServicioController">
    <top>
        <HBox spacing="10.0" styleClass="top-bar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="titulo-app" text="Gestión de Servicios - Agregar o Editar Servicio" />
            </children>
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <children>
            <HBox layoutX="26.0" layoutY="110.0" prefHeight="18.0" prefWidth="472.0">
               <children>
                  <VBox prefHeight="63.0" prefWidth="141.0">
                     <children>
                        <Label prefHeight="38.0" prefWidth="141.0" styleClass="subtitulo-login" text="Categoria">
                           <padding>
                              <Insets bottom="10.0" right="10.0" top="10.0" />
                           </padding>
                        </Label>
                        <ComboBox fx:id="cmbCategoriaServicio" prefWidth="150.0" />
                     </children>
                     <padding>
                        <Insets right="20.0" />
                     </padding>
                  </VBox>
                  <VBox alignment="BOTTOM_LEFT" prefHeight="63.0" prefWidth="90.0">
                     <children>
                        <Button fx:id="btnModificarCategoria" alignment="CENTER" contentDisplay="CENTER" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#modificarCategoria" prefHeight="35.0" prefWidth="87.0" styleClass="btn-secondary" text="Modificar" textAlignment="CENTER" />
                     </children></VBox>
                  <VBox alignment="BOTTOM_LEFT" prefHeight="63.0" prefWidth="105.0">
                     <children>
                        <Button fx:id="btnEliminarCategoria" mnemonicParsing="false" onAction="#eliminarCategoria" prefHeight="35.0" prefWidth="87.0" styleClass="btn-secondary" text="Eliminar" />
                     </children>
                  </VBox>
                  <VBox alignment="BOTTOM_RIGHT" prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Button fx:id="btnCrearCategoria" mnemonicParsing="false" onAction="#crearCategoria" prefHeight="35.0" prefWidth="88.0" styleClass="btn-secondary" text="Nueva" />
                     </children>
                  </VBox>
               </children>
            </HBox>
                <Label styleClass="subtitulo-login" text="Datos del Servicio" />
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtNombreServicio" promptText="Nombre del Servicio" styleClass="md-textfield" />
                        <TextField fx:id="txtDescripcionServicio" prefHeight="39.0" prefWidth="212.0" promptText="Descripción del servicio" styleClass="md-textfield" />
                    </children>
                </HBox>
                <HBox prefHeight="18.0" prefWidth="472.0">
                    <children>
                        <VBox prefHeight="77.0" prefWidth="152.0">
                            <children>
                                <Label prefHeight="38.0" prefWidth="141.0" styleClass="subtitulo-login" text="Duración (horas)">
                                    <padding>
                                        <Insets bottom="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Label>
                                <TextField fx:id="txtDuracionHoras" prefHeight="39.0" prefWidth="124.0" promptText="Horas de duración" styleClass="md-textfield">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" />
                                    </padding>
                                </TextField>
                            </children>
                            <padding>
                                <Insets right="20.0" />
                            </padding>
                        </VBox>
                        <VBox prefHeight="77.0" prefWidth="129.0">
                            <children>
                                <Label prefHeight="38.0" prefWidth="118.0" styleClass="subtitulo-login" text="Precio">
                                    <padding>
                                        <Insets bottom="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Label>
                                <TextField fx:id="txtPrecio" prefHeight="39.0" prefWidth="128.0" promptText=" Precio" styleClass="md-textfield" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER" layoutX="26.0" layoutY="269.0" spacing="10.0">
                    <children>
                        <Label fx:id="lblMensaje" styleClass="mensaje" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" layoutX="26.0" layoutY="56.0" spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#Guardar" styleClass="btn-primary" text="Guardar" />
                        <Button fx:id="Cancelar" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#Cancelar" styleClass="btn-secondary" text="Cancelar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
    <bottom>
        <Label styleClass="pie" text="© 2025 Seminario de Práctica Informática - Siglo 21" BorderPane.alignment="TOP_LEFT" />
    </bottom>
</BorderPane>
